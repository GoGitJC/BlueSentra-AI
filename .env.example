BLUESENTRA_ENV=dev
LOG_LEVEL=INFO

# PostgreSQL (local docker-compose defaults)
DATABASE_URL=postgresql+psycopg://bluesentra:bluesentra@localhost:5432/bluesentra

# Local Streamlit Network Events viewer (server-side only; required for that view)
# BLUESENTRA_VIEWER_MSP_ID=

# Optional: Streamlit dashboard AI triage (prototype only)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
